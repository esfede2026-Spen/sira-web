:root{--navy:#06396f;--blue:#126aa5;--cyan:#42afd0;--gold:#ffc21c;--ink:#102745;--muted:#687d98;--bg:#f2f6fa;--line:#d5e2ef;--red:#bd3030}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font-family:Segoe UI,Arial,sans-serif}.top{min-height:92px;background:linear-gradient(100deg,var(--navy),var(--blue));display:flex;justify-content:space-between;align-items:center;padding:10px 4%;box-shadow:0 5px 20px #062d552a}.brand{display:flex;gap:14px;align-items:center;color:#fff;text-decoration:none}.brand img{width:72px;height:72px;object-fit:contain}.brand span{display:flex;flex-direction:column}.brand b{font-size:28px;letter-spacing:6px}.brand small{font-size:12px}.top nav{display:flex;align-items:center;gap:6px}.top nav>a,.top nav button{color:white;background:transparent;border:0;border-radius:9px;padding:12px;text-decoration:none;font-weight:700;font-size:14px}.top nav>div{position:relative}.top menu{display:none;position:absolute;top:32px;left:0;background:white;border-radius:12px;padding:8px;min-width:170px;box-shadow:0 15px 35px #061c3340}.top nav>div:hover menu{display:flex;flex-direction:column}.top menu a{color:var(--ink);padding:9px;text-decoration:none}.exit{border:1px solid #ffffff70!important}main{max-width:1420px;margin:0 auto;padding:36px 28px;min-height:calc(100vh - 150px)}footer{text-align:center;color:var(--muted);font-size:12px;padding:20px}.msg{max-width:900px;margin:0 auto 18px;padding:14px;border-radius:12px;background:#e2edf5}.msg.error{background:#ffe0e0;color:#8c2020}.msg.success{background:#dff3e9;color:#17664f}.msg.info{background:#fff2c5}.login{max-width:1100px;margin:20px auto;display:grid;grid-template-columns:1.1fr .9fr;background:linear-gradient(120deg,var(--navy),var(--blue));border-radius:28px;overflow:hidden;box-shadow:0 22px 60px #06395f38}.welcome{color:white;padding:55px}.welcome img{width:200px;height:200px;object-fit:contain;display:block;margin-bottom:20px}.welcome span,.head span{text-transform:uppercase;letter-spacing:2px;color:var(--cyan);font-weight:800;font-size:12px}.welcome h1{font-size:45px;margin:12px 0}.login .card{margin:25px;align-self:center}.hero{background:linear-gradient(110deg,var(--navy),var(--blue));color:white;border-radius:24px;padding:45px}.hero h1{font-size:38px}.primary,.secondary,.ghost,.danger{display:inline-block;border:0;border-radius:10px;padding:12px 18px;text-decoration:none;font-weight:800;cursor:pointer}.primary{background:var(--blue);color:white}.secondary{background:#e2edf5;color:var(--navy)}.ghost{border:1px solid #ffffff77;color:white;margin-left:10px}.gold{background:var(--gold);color:var(--navy)}.danger{background:var(--red);color:white}.full{width:100%}.metrics{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin:22px 0}.metrics a,.card,.table{background:white;border-radius:18px;box-shadow:0 8px 28px #06395f12}.metrics a{padding:24px;text-decoration:none;color:var(--ink);display:flex;flex-direction:column}.metrics b{font-size:34px;color:var(--blue)}.head{display:flex;justify-content:space-between;align-items:center;margin-bottom:20px}.head h1{margin:6px 0}.head p{color:var(--muted)}.table{overflow:auto}.table table{width:100%;border-collapse:collapse}.table th,.table td{padding:14px 16px;text-align:left;border-bottom:1px solid #e5edf5;white-space:nowrap}.table th{background:#dbe9f4;color:var(--navy)}.table i{font-style:normal;background:#dcf2e9;color:#17664f;padding:5px 9px;border-radius:20px;font-size:11px;font-weight:800}.actions{display:flex;gap:12px}.actions a{color:var(--blue);font-weight:750}.danger-link{color:var(--red)!important}.wizard{display:flex;gap:18px;align-items:center}.wizard>b{width:62px;height:62px;background:var(--gold);display:grid;place-items:center;clip-path:polygon(25% 7%,75% 7%,100% 50%,75% 93%,25% 93%,0 50%)}.wizard h1{margin:0}.wizard p{color:var(--muted)}.steps{display:grid;grid-template-columns:repeat(5,1fr);list-style:none;padding:0}.steps li{background:#dce9f3;text-align:center;padding:14px;color:var(--muted);font-size:13px;font-weight:750;border-right:2px solid var(--bg)}.steps .on{background:var(--gold);color:var(--navy)}.card{padding:28px;margin-bottom:20px}.note,.alert{padding:14px;border-radius:11px;margin-bottom:18px;display:flex;flex-direction:column}.note{background:#edf6f8;border-left:5px solid var(--cyan)}.alert{background:#ffe2e2;color:#862323}.grid,.two{display:grid;grid-template-columns:1fr 1fr;gap:20px}form p{display:flex;flex-direction:column;gap:7px}label{font-weight:750}input,select,textarea{width:100%;padding:12px;border:1px solid #c8d8e8;border-radius:10px;background:white}input:focus,select:focus,textarea:focus{outline:3px solid #42afd02b;border-color:var(--cyan)}.grid p:has(input[type=hidden]){display:none}.buttons{display:flex;justify-content:flex-end;gap:12px;margin:20px 0}.list{list-style:none;padding:0}.list li{display:flex;justify-content:space-between;align-items:center;padding:10px;border-top:1px solid var(--line)}.list em{font-style:normal;color:#17664f}.mini{padding:6px 9px;border:0;border-radius:7px}.result img,.public img{width:220px;height:220px;object-fit:contain}.public{max-width:650px;margin:40px auto;text-align:center}.confirm{max-width:760px;margin:30px auto}dl{display:grid;grid-template-columns:180px 1fr;gap:10px}dd{margin:0}@media(max-width:900px){.top{align-items:flex-start}.top nav{flex-wrap:wrap;justify-content:flex-end}.brand small{display:none}.login,.grid,.two,.metrics{grid-template-columns:1fr}.steps{grid-template-columns:1fr 1fr}.head{align-items:flex-start;gap:15px}.welcome img{width:140px;height:140px}}
.venezuela-map{width:310px!important;height:280px!important;object-fit:contain!important;margin:-20px auto 5px!important;display:block!important}.sira-logo-login{width:115px!important;height:115px!important;margin:0 auto 4px!important}.captcha-box{display:flex;align-items:center;gap:14px;margin:12px 0}.captcha-box img{width:220px;height:70px;border:1px solid #b9cfe2;border-radius:9px}.captcha-box a{font-size:13px;color:var(--blue)}.errorlist{color:#a32424;margin:4px 0;padding-left:20px}

.login .welcome{position:relative;padding:25px 34px}.venezuela-map{width:80%!important;height:auto!important;max-height:470px!important;margin:-18px auto 0!important;object-fit:contain!important}.sira-logo-login{position:relative;z-index:2;width:130px!important;height:130px!important;margin:0 auto -25px!important}.login{grid-template-columns:1.25fr .75fr}.profile-tabs.v41{display:flex;gap:8px;overflow:auto;margin:14px 0 20px}.profile-tabs.v41 a{padding:11px 14px;background:#e1edf6;color:#06396f;border-radius:9px;text-decoration:none;font-weight:750;white-space:nowrap}
