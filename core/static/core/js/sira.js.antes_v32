document.addEventListener('DOMContentLoaded',()=>{const form=document.querySelector('#residencia-form');if(!form)return;const chain=[['paisId','estados','paisId','estadoId','id_estado','desc_estado'],['estadoId','ciudades','estadoId','ciudadId','id_ciudad','desc_ciudad'],['ciudadId','municipios','ciudadId','municipioId','id_municipio','desc_municipio'],['municipioId','parroquias','municipioId','parroquiaId','id_parroquia','desc_parroquia'],['parroquiaId','sectores','parroquiaId','sectorId','id_sector_geografico','desc_sector_geografico'],['sectorId','codigos-postales','sectorId','codigoPostalId','id_codigo_postal','codigo_postal']];chain.forEach((c,i)=>{const src=document.querySelector('#id_'+c[0]);if(!src)return;src.addEventListener('change',async()=>{for(let j=i;j<chain.length;j++){const t=document.querySelector('#id_'+chain[j][3]);if(t)t.innerHTML='<option value="">Seleccione…</option>'}if(!src.value)return;const r=await fetch(`${form.dataset.geoUrl}${c[1]}/?${c[2]}=${encodeURIComponent(src.value)}`);const data=await r.json();const target=document.querySelector('#id_'+c[3]);data.forEach(x=>target.add(new Option(x[c[5]],x[c[4]])));});});});
