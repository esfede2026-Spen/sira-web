{% extends 'core/base.html' %}{% block title %}Grupos · SIRA{% endblock %}{% block content %}<div class="wizard"><b>P10</b><div><h1>Grupos</h1><p>{{p.primer_nombre}} {{p.primer_apellido}} · Puede pertenecer a uno o más grupos.</p></div></div>{% include 'core/_steps.html' %}<section class="card"><form method="post">{% csrf_token %}{{form.as_p}}<button class="primary">Agregar grupo</button></form><ul class="list">{% for x in rows %}<li><span>{{x.descripcion}}</span><form method="post" action="{% url 'persona_grupo_quitar' pid x.id_grupo %}">{% csrf_token %}<button class="danger mini">Retirar</button></form></li>{% empty %}<li>No tiene grupos asociados.</li>{% endfor %}</ul></section><div class="buttons"><a class="secondary" href="{% url 'persona_academico' pid %}">Regresar</a><a class="primary" href="{% url 'personas' %}">Finalizar</a></div>{% endblock %}
