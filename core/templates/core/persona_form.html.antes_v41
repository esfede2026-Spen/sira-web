{% extends 'core/base.html' %}{% block title %}{% if modo == 'crear' %}Registrar{% else %}Editar{% endif %} persona · SIRA{% endblock %}{% block content %}<div class="wizard"><b>P0{% if modo == 'crear' %}2{% else %}4{% endif %}</b><div><h1>{% if modo == 'crear' %}Registro{% else %}Editar perfil{% endif %} de persona</h1><p>Identificación y datos personales.</p></div></div>{% include 'core/_steps.html' %}<section class="card"><div class="note"><b>Regla central</b><small>La Persona se guarda separada de la cuenta Usuario.</small></div><form method="post">{% csrf_token %}<div class="grid">{{form.as_p}}</div><div class="buttons"><a class="secondary" href="{% url 'personas' %}">Regresar</a><button class="primary">Guardar y continuar</button></div></form></section>{% endblock %}
