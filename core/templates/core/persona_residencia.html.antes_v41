{% extends 'core/base.html' %}{% load static %}{% block title %}Territorio · SIRA{% endblock %}{% block content %}<div class="wizard"><b>P07</b><div><h1>Residencia y territorio</h1><p>{{p.primer_nombre}} {{p.primer_apellido}}</p></div></div>{% include 'core/_steps.html' %}<section class="card"><form method="post" id="residencia-form" data-geo-url="/ajax/geografia/">{% csrf_token %}<div class="grid">{{form.as_p}}</div><div class="buttons"><a class="secondary" href="{% url 'persona_contacto' pid %}">Regresar</a><button class="primary">Guardar y finalizar</button></div></form></section>{% endblock %}
