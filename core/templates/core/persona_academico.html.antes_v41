{% extends 'core/base.html' %}{% block title %}Datos académicos · SIRA{% endblock %}{% block content %}<div class="wizard"><b>P09</b><div><h1>Datos académicos</h1><p>{{p.primer_nombre}} {{p.primer_apellido}} · Todos los campos son opcionales.</p></div></div>{% include 'core/_steps.html' %}<section class="card"><form method="post">{% csrf_token %}<div class="grid">{{form.as_p}}</div><div class="buttons"><a class="secondary" href="{% url 'persona_residencia' pid %}">Regresar</a><button class="primary">Guardar y continuar</button></div></form></section>{% endblock %}
