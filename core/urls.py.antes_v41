from django.urls import path
from . import views
urlpatterns=[path('',views.home,name='home'),path('login/',views.login_view,name='login'),path('captcha.png',views.captcha_imagen,name='captcha_imagen'),path('salir/',views.salir,name='salir'),path('personas/',views.personas,name='personas'),path('personas/nueva/',views.persona_nueva,name='persona_nueva'),path('personas/<int:pid>/editar/',views.persona_editar,name='persona_editar'),path('personas/<int:pid>/contacto/',views.persona_contacto,name='persona_contacto'),path('personas/<int:pid>/contacto/<str:tipo>/<int:cid>/borrar/',views.contacto_borrar,name='contacto_borrar'),path('personas/<int:pid>/residencia/',views.persona_residencia,name='persona_residencia'),path('personas/<int:pid>/resumen/',views.persona_resumen,name='persona_resumen'),path('personas/<int:pid>/academico/',views.persona_academico,name='persona_academico'),path('personas/<int:pid>/grupos/',views.persona_grupos,name='persona_grupos'),path('personas/<int:pid>/grupos/<int:gid>/quitar/',views.persona_grupo_quitar,name='persona_grupo_quitar'),path('personas/<int:pid>/',views.persona_resumen,name='persona_detalle'),path('personas/<int:pid>/eliminar/',views.persona_eliminar,name='persona_eliminar'),path('personas/<int:pid>/usuario/',views.usuario_crear,name='usuario_crear'),path('usuarios/',views.usuarios,name='usuarios'),path('invitaciones/',views.invitaciones,name='invitaciones'),path('registro/<str:token>/',views.registro_publico,name='registro_publico'),path('ajax/geografia/<str:tipo>/',views.geo_json,name='geo_json')]
